{
  "id": "/admin",
  "name": "Afridyn Admin",
  "short_name": "Afridyn",
  "description": "Quotations, invoices, receipts, delivery notes and statements for Afridyn Engineering Limited. Works offline.",
  "start_url": "/admin",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#07090D",
  "theme_color": "#07090D",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New quotation", "url": "/admin/documents/new?type=quotation" },
    { "name": "New invoice", "url": "/admin/documents/new?type=invoice" },
    { "name": "Documents", "url": "/admin/documents" }
  ]
}
