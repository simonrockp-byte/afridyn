# Afridyn — environment variables. Copy to .env.local for local work; never commit real values.
# On Vercel these are set under Project → Settings → Environment Variables.

# Public site URL (canonical links, sitemap). Leave unset to use https://afridyn.world.
NEXT_PUBLIC_SITE_URL=

# --- Admin (docs/ADMIN_BUILD_PLAN.md) ---------------------------------------

# Neon Postgres. Set automatically by the Vercel ↔ Neon integration (afridyn-db).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs admin session cookies. Optional: if unset, a key is derived from
# DATABASE_URL. Recommended to set your own (32+ random characters):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Owner account, created once during the next deploy (scripts/migrate.mjs).
# The password is never overwritten afterwards unless ADMIN_RESET_PASSWORD=1.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=

# Vercel Blob (product photos, logo). Set automatically by the afridyn-blob store.
BLOB_READ_WRITE_TOKEN=

# --- Contact form email (app/api/contact) ------------------------------------
RESEND_API_KEY=
CONTACT_EMAIL=
